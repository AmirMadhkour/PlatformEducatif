# URL complete du backend (SANS /api a la fin, ajoute automatiquement par src/services/api.js)
VITE_API_URL=http://localhost:8080

# Numero WhatsApp de l'administration (format international, sans "+" ni espaces, ex: 21612345678)
# Utilise uniquement pour construire un lien wa.me cote client - ce n'est pas un secret
# (un numero de contact public), mais reste configurable pour ne pas le coder en dur.
VITE_WHATSAPP_ADMIN_NUMBER=21600000000
